generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Data Alvo do Concurso/Objetivo
  targetExamDate DateTime?

  // Meta de estudo semanal do usuário
  studyMode         String @default("WEEKLY") // "WEEKLY" ou "CYCLE"
  weeklyGoalHours   Int    @default(10)
  activeDaysPerWeek Int    @default(5)
  cycleCurrentIndex Int    @default(0) // Ponteiro do bloco atual no Ciclo (#1 a #12)
  cycleLap          Int    @default(1) // Quantas voltas já concluiu

  // Relações do NextAuth
  accounts Account[]
  sessions Session[]

  // Relações de Estudo
  subjects      Subject[]
  studySessions StudySession[]
  quizzes       Quiz[]

  // 🏆 Gamificação
  userStats UserStats?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 🏆 Modelo para Gamificação e XP
model UserStats {
  id                  String    @id @default(cuid())
  userId              String    @unique
  totalXp             Int       @default(0)
  streakDays          Int       @default(0)
  claimedAchievements String    @default("")
  lastStudyDate       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subject {
  id          String  @id @default(uuid())
  name        String
  importance  String
  color       String? @default("#3B82F6")
  priority    Float   @default(6.3) // Peso da matéria no edital (ex: 1.0 a 10.0)
  assignedDay Int? // Overrided day index (0 = Segunda, 1 = Terça, ..., null = cálculo dinâmico)

  // --- CAMPOS PARA SRS / SM-2 PONDERADO ---
  lastReviewed DateTime @default(now())
  nextReview   DateTime @default(now())
  interval     Int      @default(1)
  easiness     Float    @default(2.5)

  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics    Topic[]
  decks     Deck[]
}

model Topic {
  id        String  @id @default(uuid())
  title     String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // 🔗 Relações diretas com baralhos e revisões
  decks           Deck[]
  flashcards      Flashcard[]
  questions       Quiz[]
  reviewHistories ReviewHistory[]
  quizAttempts    QuizAttempt[]

  // Estado do Estudo
  firstStudy  String    @default("Pendente") // "Pendente", "Em Estudo", "Concluido"
  performance Int       @default(0) // Porcentagem calculada (0 a 100%)
  easiness    Float     @default(2.5)
  relevance   String?   @default("5/10")
  interval    Int       @default(0)
  repetitions Int       @default(0)
  lastRev     DateTime?
  nextRev     DateTime? @default(now())
  lastQuizAt  DateTime?
}

model Deck {
  id        String   @id @default(cuid())
  title     String
  color     String
  createdAt DateTime @default(now())

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  // 🔗 Vínculo direto do Deck com o Tópico do Edital
  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  flashcards Flashcard[]
  userId     String
}

model QuizAttempt {
  id           String   @id @default(uuid())
  userId       String
  topicId      String
  totalCount   Int // Total de questões no quiz
  correctCount Int // Questões acertadas
  completedAt  DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id        String   @id @default(cuid())
  question  String
  answer    String
  details   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  deckId String
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id])
}

model ReviewHistory {
  id              String   @id @default(uuid())
  topicId         String
  grade           String
  durationSeconds Int?     @default(60)
  reviewedAt      DateTime @default(now())
  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Quiz {
  id         String   @id @default(uuid())
  banca      String
  subject    String
  difficulty String
  questions  Json
  createdAt  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  topic   Topic?  @relation(fields: [topicId], references: [id])
  topicId String?

  @@map("quizzes")
}

model StudySession {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  status          String   @default("COMPLETED")
  durationMinutes Int?     @default(0)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([userId])
}

// 🏅 Progresso do Usuário em Conquistas/Insígnias
model UserAchievementProgress {
  id            String    @id @default(cuid())
  userId        String
  achievementId String // ID da conquista (ex: "level_5", "fire_starter")
  currentValue  Int       @default(0)
  isUnlocked    Boolean   @default(false)
  unlockedAt    DateTime?
  isClaimed     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, achievementId])
  @@index([userId])
}
