# ==============================================================================
# SYNAPSE AI - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# BANCO DE DADOS (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/synapse"

# GOOGLE GEMINI AI
GEMINI_API_KEY="seu_gemini_api_key_aqui"

# AUTENTICAÇÃO (Auth.js / NextAuth v5)
AUTH_SECRET="chave_secreta_aleatoria_openssl_rand_base64_32"

# PROVEDORES OAUTH (Opcional para Login Social)
AUTH_GOOGLE_ID="google_client_id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="google_client_secret"
AUTH_GITHUB_ID="github_oauth_client_id"
AUTH_GITHUB_SECRET="github_oauth_client_secret"

# ==============================================================================
# INFRAESTRUTURA DE ANÚNCIOS & MONETIZAÇÃO (AD NETWORK / GOOGLE ADSENSE / IMA)
# ==============================================================================
# Provedor ativo de anúncios para o plano gratuito:
# Opções: "SPONSOR_SIMULATOR" (padrão) | "GOOGLE_ADSENSE" | "GOOGLE_IMA" | "CUSTOM_VIDEO"
NEXT_PUBLIC_AD_PROVIDER="SPONSOR_SIMULATOR"

# Habilita ou desabilita globalmente os anúncios
NEXT_PUBLIC_ADS_ENABLED="true"

# Google AdSense (Configurar quando a conta for aprovada pelo Google)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADSENSE_REWARDED_SLOT_ID=""

# Google IMA SDK (Interactive Media Ads - VAST/VMAP Tag de vídeo)
NEXT_PUBLIC_IMA_VAST_TAG_URL=""

# Vídeo Customizado de Patrocinador (URL MP4 direta ou CDN)
NEXT_PUBLIC_CUSTOM_AD_VIDEO_URL=""
